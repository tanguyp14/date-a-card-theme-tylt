{% doc %}
  @prompt
    Je voudrais trois bouton rouges comme dans mon thème, avec le texte blanc
    
    Pour 3 liens différents, cartes à lunité, la boutique DAC et actualités, La même chose mais avec le texte pas en gras les trois boutons centrés en fonction de la page, Pour la version mobile, resserrer les 3 boutons et les réduire un peu pour pas que ça prenne toute la largeur de la page, Pour la version mobile, il y a trop d'écart entre les boutons, il faut les resserer sur la hauteur
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-buttons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-right: auto;
    margin-left: auto;
  }

  .ai-three-buttons-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-three-buttons-{{ ai_gen_id }}__item {
    flex: 0 1 260px;
    min-width: 180px;
  }

  .ai-three-buttons-{{ ai_gen_id }}__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 14px 22px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .ai-three-buttons-{{ ai_gen_id }}__link:hover {
    background-color: {{ block.settings.hover_color }};
    border-color: {{ block.settings.hover_color }};
    color: {{ block.settings.text_color }};
    transform: translateY(-2px);
  }

  .ai-three-buttons-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-three-buttons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-three-buttons-{{ ai_gen_id }}__list {
      flex-direction: column;
      align-items: center;
      gap: 3px;
    }

    .ai-three-buttons-{{ ai_gen_id }}__item {
      width: 85%;
      min-width: 0;
      max-width: 280px;
    }

    .ai-three-buttons-{{ ai_gen_id }}__link {
      min-height: 40px;
      padding: 8px 18px;
      font-size: calc({{ block.settings.text_size }}px - 2px);
    }
  }
{% endstyle %}

<div class="ai-three-buttons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <ul class="ai-three-buttons-{{ ai_gen_id }}__list" role="list">
    <li class="ai-three-buttons-{{ ai_gen_id }}__item">
      <a class="ai-three-buttons-{{ ai_gen_id }}__link" href="{{ block.settings.cards_link }}">{{ block.settings.cards_label | escape }}</a>
    </li>
    <li class="ai-three-buttons-{{ ai_gen_id }}__item">
      <a class="ai-three-buttons-{{ ai_gen_id }}__link" href="{{ block.settings.shop_link }}">{{ block.settings.shop_label | escape }}</a>
    </li>
    <li class="ai-three-buttons-{{ ai_gen_id }}__item">
      <a class="ai-three-buttons-{{ ai_gen_id }}__link" href="{{ block.settings.news_link }}">{{ block.settings.news_label | escape }}</a>
    </li>
  </ul>
</div>

{% schema %}
{
  "name": "Trois boutons rouges",
  "settings": [
    { "type": "header", "content": "Bouton 1" },
    { "type": "text", "id": "cards_label", "label": "Texte", "default": "Cartes à l'unité" },
    { "type": "url", "id": "cards_link", "label": "Lien" },
    { "type": "header", "content": "Bouton 2" },
    { "type": "text", "id": "shop_label", "label": "Texte", "default": "La boutique DAC" },
    { "type": "url", "id": "shop_link", "label": "Lien" },
    { "type": "header", "content": "Bouton 3" },
    { "type": "text", "id": "news_label", "label": "Texte", "default": "Actualités" },
    { "type": "url", "id": "news_link", "label": "Lien" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largeur sur ordinateur", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "button_color", "label": "Fond", "default": "#e41515" },
    { "type": "color", "id": "hover_color", "label": "Fond au survol", "default": "#b30000" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#ffffff" },
    { "type": "color", "id": "focus_color", "label": "Contour de focus", "default": "#281916" },
    { "type": "range", "id": "text_size", "label": "Taille du texte", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "border_radius", "label": "Arrondi", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "border_thickness", "label": "Épaisseur de bordure", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1 }
  ],
  "presets": [{ "name": "Trois boutons rouges" }],
  "tag": null,
  "class": "trois-boutons-rouges"
}
{% endschema %}