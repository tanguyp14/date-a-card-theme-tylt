{% doc %}
  @prompt
    Un carousel de photos pour présenter la boutique dateacard, avec un petit effet lumineux rouge autour, Mettre une marge blanche de la même taille autour du bloc de la photo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dateacard-carousel-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.white_margin }}px;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #ffffff;
    box-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }};
  }
  .ai-dateacard-carousel__heading-{{ ai_gen_id }} { margin: 0 0 18px; color: {{ block.settings.text_color }}; font-family: {{ block.settings.heading_font.family }}; font-size: {{ block.settings.heading_size }}px; text-align: {{ block.settings.text_alignment }}; }
  .ai-dateacard-carousel__viewport-{{ ai_gen_id }} { position: relative; overflow: hidden; border-radius: {{ block.settings.corner_radius }}px; background: #f2f2f2; }
  .ai-dateacard-carousel__track-{{ ai_gen_id }} { display: flex; transition: transform 0.35s ease; }
  .ai-dateacard-carousel__slide-{{ ai_gen_id }} { position: relative; flex: 0 0 100%; aspect-ratio: {{ block.settings.image_ratio }}; }
  .ai-dateacard-carousel__slide-{{ ai_gen_id }} img, .ai-dateacard-carousel__placeholder-{{ ai_gen_id }} { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-dateacard-carousel__placeholder-{{ ai_gen_id }} { position: relative; display: flex; align-items: center; justify-content: center; color: #666666; }
  .ai-dateacard-carousel__placeholder-{{ ai_gen_id }} svg { width: 42%; height: 42%; }
  .ai-dateacard-carousel__empty-{{ ai_gen_id }} { position: absolute; bottom: 18px; left: 50%; width: calc(100% - 36px); transform: translateX(-50%); color: #333333; font-size: 14px; text-align: center; }
  .ai-dateacard-carousel__caption-{{ ai_gen_id }} { position: absolute; right: 0; bottom: 0; left: 0; padding: 28px 20px 16px; color: #ffffff; background: linear-gradient(transparent, rgba(0, 0, 0, 0.72)); font-size: 16px; }
  .ai-dateacard-carousel__button-{{ ai_gen_id }} { position: absolute; top: 50%; z-index: 2; display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; padding: 0; border: 1px solid #ffffff; border-radius: 50%; color: #ffffff; background: rgba(0, 0, 0, 0.62); cursor: pointer; transform: translateY(-50%); }
  .ai-dateacard-carousel__button-{{ ai_gen_id }}:hover, .ai-dateacard-carousel__button-{{ ai_gen_id }}:focus-visible { background: {{ block.settings.glow_color }}; }
  .ai-dateacard-carousel__button-{{ ai_gen_id }}:focus-visible, .ai-dateacard-carousel__dot-{{ ai_gen_id }}:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }
  .ai-dateacard-carousel__button--previous-{{ ai_gen_id }} { left: 14px; }
  .ai-dateacard-carousel__button--next-{{ ai_gen_id }} { right: 14px; }
  .ai-dateacard-carousel__button-{{ ai_gen_id }} svg { width: 20px; height: 20px; }
  .ai-dateacard-carousel__dots-{{ ai_gen_id }} { display: flex; justify-content: center; gap: 8px; padding: 16px 0 4px; }
  .ai-dateacard-carousel__dot-{{ ai_gen_id }} { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 50%; background: #999999; cursor: pointer; }
  .ai-dateacard-carousel__dot-{{ ai_gen_id }}[aria-current="true"] { background: {{ block.settings.glow_color }}; box-shadow: 0 0 8px {{ block.settings.glow_color }}; }
  @media screen and (max-width: 749px) { .ai-dateacard-carousel-{{ ai_gen_id }} { width: 100%; } .ai-dateacard-carousel__button-{{ ai_gen_id }} { width: 36px; height: 36px; } .ai-dateacard-carousel__button--previous-{{ ai_gen_id }} { left: 8px; } .ai-dateacard-carousel__button--next-{{ ai_gen_id }} { right: 8px; } }
{% endstyle %}

<dateacard-carousel-{{ ai_gen_id }} class="ai-dateacard-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-dateacard-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>{% endif %}
  <div class="ai-dateacard-carousel__viewport-{{ ai_gen_id }}" aria-label="{{ block.settings.carousel_label | escape }}">
    <div class="ai-dateacard-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign caption_key = 'caption_' | append: i
          assign image = block.settings[image_key]
          assign caption = block.settings[caption_key]
        %}
        {% if image != blank %}<div class="ai-dateacard-carousel__slide-{{ ai_gen_id }}" role="group" aria-label="Photo {{ i }}"><img src="{{ image | image_url: width: 1800 }}" alt="{{ image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% if caption != blank %}<div class="ai-dateacard-carousel__caption-{{ ai_gen_id }}">{{ caption }}</div>{% endif %}</div>{% endif %}
      {% endfor %}
      {% if block.settings.image_1 == blank and block.settings.image_2 == blank and block.settings.image_3 == blank and block.settings.image_4 == blank and block.settings.image_5 == blank %}<div class="ai-dateacard-carousel__slide-{{ ai_gen_id }}"><div class="ai-dateacard-carousel__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<div class="ai-dateacard-carousel__empty-{{ ai_gen_id }}">Ajoutez des photos de la boutique dans les réglages du bloc.</div></div></div>{% endif %}
    </div>
    <button class="ai-dateacard-carousel__button-{{ ai_gen_id }} ai-dateacard-carousel__button--previous-{{ ai_gen_id }}" type="button" aria-label="Photo précédente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"></path></svg></button>
    <button class="ai-dateacard-carousel__button-{{ ai_gen_id }} ai-dateacard-carousel__button--next-{{ ai_gen_id }}" type="button" aria-label="Photo suivante"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg></button>
  </div>
  <div class="ai-dateacard-carousel__dots-{{ ai_gen_id }}" role="tablist" aria-label="Choisir une photo"></div>
</dateacard-carousel-{{ ai_gen_id }}>

<script>
(function() {
  class DateacardCarousel{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.ai-dateacard-carousel__track-{{ ai_gen_id }}'); this.slides = this.querySelectorAll('.ai-dateacard-carousel__slide-{{ ai_gen_id }}'); this.dots = this.querySelector('.ai-dateacard-carousel__dots-{{ ai_gen_id }}'); this.index = 0;
      this.querySelector('.ai-dateacard-carousel__button--previous-{{ ai_gen_id }}').addEventListener('click', () => this.move(-1)); this.querySelector('.ai-dateacard-carousel__button--next-{{ ai_gen_id }}').addEventListener('click', () => this.move(1));
      this.slides.forEach((slide, index) => { const dot = document.createElement('button'); dot.type = 'button'; dot.className = 'ai-dateacard-carousel__dot-{{ ai_gen_id }}'; dot.setAttribute('role', 'tab'); dot.setAttribute('aria-label', 'Afficher la photo ' + (index + 1)); dot.addEventListener('click', () => this.show(index)); this.dots.appendChild(dot); }); this.show(0);
    }
    move(direction) { this.show((this.index + direction + this.slides.length) % this.slides.length); }
    show(index) { this.index = index; this.track.style.transform = 'translateX(-' + (index * 100) + '%)'; this.dots.querySelectorAll('button').forEach((dot, dotIndex) => dot.setAttribute('aria-current', dotIndex === index ? 'true' : 'false')); }
  }
  customElements.define('dateacard-carousel-{{ ai_gen_id }}', DateacardCarousel{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Carousel boutique",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Découvrez DateACard" },
    { "type": "text", "id": "carousel_label", "label": "Libellé accessible", "default": "Photos de la boutique DateACard" },
    { "type": "font_picker", "id": "heading_font", "label": "Police du titre", "default": "futura_n4" },
    { "type": "range", "id": "heading_size", "label": "Taille du titre", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "select", "id": "text_alignment", "label": "Alignement", "options": [{"value":"left","label":"Gauche"},{"value":"center","label":"Centre"},{"value":"right","label":"Droite"}], "default": "center" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largeur bureau", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "image_ratio", "label": "Format des photos", "options": [{"value":"4 / 3","label":"Paysage"},{"value":"1 / 1","label":"Carré"},{"value":"3 / 4","label":"Portrait"}], "default": "4 / 3" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" }, { "type": "text", "id": "caption_1", "label": "Légende 1" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" }, { "type": "text", "id": "caption_2", "label": "Légende 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" }, { "type": "text", "id": "caption_3", "label": "Légende 3" },
    { "type": "image_picker", "id": "image_4", "label": "Photo 4" }, { "type": "text", "id": "caption_4", "label": "Légende 4" },
    { "type": "image_picker", "id": "image_5", "label": "Photo 5" }, { "type": "text", "id": "caption_5", "label": "Légende 5" },
    { "type": "header", "content": "Marge et lumière" },
    { "type": "range", "id": "white_margin", "label": "Marge blanche autour de la photo", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#281916" },
    { "type": "color", "id": "glow_color", "label": "Lueur rouge", "default": "#e41515" },
    { "type": "range", "id": "glow_size", "label": "Intensité de la lueur", "min": 4, "max": 36, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "corner_radius", "label": "Arrondi", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 }
  ],
  "presets": [{ "name": "Carousel boutique" }],
  "tag": null,
  "class": "dateacard-carousel-block"
}
{% endschema %}